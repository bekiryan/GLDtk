        <mxCell id="ed_sel" value="&lt;font style='font-size:10px' color='#0F766E'&gt;&lt;b&gt;[SELECT]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;1. Designer Selection &amp;amp; Mode&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Region (GldtkAreaTool lasso)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Section (dropdown / structure)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Entities (selected / rect / level)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Describe (POST /edit/locate)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
