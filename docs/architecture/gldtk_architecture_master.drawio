        <mxCell id="fe_lasso" value="&lt;font style='font-size:10px' color='#4338CA'&gt;&lt;b&gt;[EDIT TOOL]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;GldtkAreaTool.hx &amp;amp; Edit Modes&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Canvas rectangle lasso tool (h2d.Graphics)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;4 Co-creative edit modes: Region · Section ·&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Entities · Describe &amp;amp; Locate highlight preview&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Undo stack button (.gldtk_history snapshots)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
