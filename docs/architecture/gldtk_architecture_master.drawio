        <mxCell id="fe_loader" value="&lt;font style='font-size:10px' color='#4338CA'&gt;&lt;b&gt;[LIFECYCLE]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;ProjectLoader &amp;amp; Electron Lifecycle&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;In-place swap: editor.selectProject() + flush&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Ignores unchanged image watcher (no false &amp;#x27;*&amp;#x27;)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Read-only guard on LDtk bundled sample levels&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Electron spawns &amp;amp; terminates gldtk-server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
