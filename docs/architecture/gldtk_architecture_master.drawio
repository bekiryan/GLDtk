  <diagram id="verification_dags" name="3 - Verification &amp; Mission DAGs">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1910" pageHeight="1215" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="verification_dags_title" value="&lt;font style='font-size:20px' color='#0F172A'&gt;&lt;b&gt;GLDtk: Formal Verification, Soft-Lock SCC/Automaton, Mission &amp;amp; Seam-Locked Edit DAGs&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#475569'&gt;Mathematical guarantees &amp;amp; non-destructive co-creative editing subsystems&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1850" height="52" as="geometry" />
        </mxCell>
        <mxCell id="g_oracle" value="&lt;b&gt;Sub-DAG A · Kinematic Physics Oracle &amp;amp; Swept-Hitbox Verification (symbolic/)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px' color='#334155'&gt;Evaluates continuous Newtonian arcs &amp;amp; 12x24 px AABB clearance across heterogeneous gravity bands&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=46;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.8;swimlaneFillColor=#ECFDF5;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="88" width="910" height="535" as="geometry" />
        </mxCell>
        <mxCell id="g_softlock" value="&lt;b&gt;Sub-DAG B · Soft-Lock Freedom Proofs &amp;amp; Auto-Repair (layout/softlock*.py)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px' color='#334155'&gt;Guarantees every reachable platform and inventory state can still reach an Exit&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=46;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.8;swimlaneFillColor=#FFF1F2;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="88" width="910" height="535" as="geometry" />
        </mxCell>
        <mxCell id="g_mission" value="&lt;b&gt;Sub-DAG C1 · Dormans Mission Grammar (mission/)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px' color='#334155'&gt;Separates abstract lock-key progression from spatial room carving&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=46;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.8;swimlaneFillColor=#F5F3FF;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="655" width="910" height="530" as="geometry" />
        </mxCell>
        <mxCell id="g_edit" value="&lt;b&gt;Sub-DAG C2 · Seam-Locked Regional Editing (edit/)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px' color='#334155'&gt;Non-destructive co-creation preserving manual edits &amp;amp; border connectivity&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=46;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.8;swimlaneFillColor=#F0FDFA;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="655" width="910" height="530" as="geometry" />
        </mxCell>
        <mxCell id="oa_ext" value="&lt;font style='font-size:10px' color='#0F766E'&gt;&lt;b&gt;[EXTRACT]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;1. Grid -&amp;gt; Graph Extractor&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;symbolic/extractor.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Scan IntGrid surface runs&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Split spans lacking &amp;gt;=2 tiles&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;overhead headroom (12x24 px)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Detect vertical WallFaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="165" width="235" height="134" as="geometry" />
        </mxCell>
        <mxCell id="oa_single" value="&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Single Parabolic Jump&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;0.5*g*t^2 - v_y*t + dy = 0&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;D = v_y^2 - 2g*dy &amp;gt;= 0; |dx/t*| &amp;lt;= v_run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="152" width="275" height="76" as="geometry" />
        </mxCell>
        <mxCell id="oa_double" value="&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;O(1) Double-Jump Apex&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Closed-form optimal launch time:&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;tau* = min((v1+sqrt((v1^2+v2^2-2g*dy)/2))/g, 2v1/g)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="240" width="275" height="76" as="geometry" />
        </mxCell>
        <mxCell id="oa_dash" value="&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Air Dash &amp;amp; Wall-Jump Climb&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Dash: |dx|&amp;#x27; = max(0, |dx|-d_dash), g_eff=0&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Wall: &amp;lt;=6 kicks, &amp;lt;=400 arcs, WallFace check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="328" width="275" height="76" as="geometry" />
        </mxCell>
        <mxCell id="oa_grav" value="&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Piecewise Cross-Section Gravity&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;symbolic/gravity.py (Flight / path_moment)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;G = 2 * int_0^1 (1-s) * g(x(s)) ds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="416" width="275" height="76" as="geometry" />
        </mxCell>
        <mxCell id="oa_sweep" value="&lt;font style='font-size:10px' color='#1D4ED8'&gt;&lt;b&gt;[SWEEP]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;2. Swept 12x24 px AABB Check&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;trajectory_clear() at ds &amp;lt;= 6 px&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Rejects solid ceiling/wall clip&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Rejects hazard spike intersection&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Tags edge with best_ability()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="655" y="175" width="260" height="128" as="geometry" />
        </mxCell>
        <mxCell id="oa_astar" value="&lt;font style='font-size:10px' color='#1D4ED8'&gt;&lt;b&gt;[ROUTE]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;3. Effort-Cost A* Route&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;symbolic/routes / layout/route.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Walk cost = 1.0/tile (walk-first)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Super-linear penalty on jumps&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Feeds Route Overlay &amp;amp; Comfort Pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="655" y="348" width="260" height="134" as="geometry" />
        </mxCell>
        <mxCell id="oa_note" value="&lt;font style='font-size:10px' color='#475569'&gt;&lt;b&gt;[VERIFIED]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Double-jump tau* matched 20,000 brute-force searches with 0 mismatches (tests/test_abilities.py)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Plain LDtk levels without gldtk_sections allow 1-tile step-ups everywhere (PR #4).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="524" width="860" height="74" as="geometry" />
        </mxCell>
        <mxCell id="sb_in" value="&lt;font style='font-size:10px' color='#475569'&gt;&lt;b&gt;[INPUT]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;1. Extracted Digraph G = (V, E)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Standable platform spans V&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Verified Walk/Jump/Fall edges&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Keys, abilities &amp;amp; locked doors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="995" y="184" width="225" height="126" as="geometry" />
        </mxCell>
        <mxCell id="sb_scc" value="&lt;font style='font-size:10px' color='#BE123C'&gt;&lt;b&gt;[SCC]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;2A. Tarjan SCC Condensation&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Condense G into DAG D = (C, E_cond)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Mark Exit SCCs Live; reverse BFS&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;V_trap = Reach(Start) \ V_live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1265" y="174" width="285" height="124" as="geometry" />
        </mxCell>
        <mxCell id="sb_prod" value="&lt;font style='font-size:10px' color='#BE123C'&gt;&lt;b&gt;[PRODUCT]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;2B. Item Automaton S = V x P(K)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Tracks up to |K|&amp;lt;=6 items (&amp;lt;=64|V|)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Forward BFS from (Start, {}) via doors&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Reverse BFS on S_rev from (V_exit, *)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Counterfactual: k_d in Reach(G\{d}, Start)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1265" y="322" width="285" height="146" as="geometry" />
        </mxCell>
        <mxCell id="sb_rep" value="&lt;font style='font-size:10px' color='#B45309'&gt;&lt;b&gt;[REPAIR]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;3. Deterministic Soft-Lock Repair&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;layout/softlock_repair.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Classifies traps: &amp;#x27;pit&amp;#x27; vs &amp;#x27;sealed&amp;#x27;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Inserts &amp;lt;=4 escape stepping stones&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Relocates keys trapped past drops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1605" y="174" width="250" height="142" as="geometry" />
        </mxCell>
        <mxCell id="sb_ok" value="&lt;font style='font-size:10px' color='#60A5FA'&gt;&lt;b&gt;[PROOF]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#F8FAFC'&gt;&lt;b&gt;4. SoftlockReport.ok == True&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;0 movement traps, 0 deadlocks&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;0 key-behind-door inversions&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;Red spans shown in Play Mode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;strokeColor=#334155;strokeWidth=1.6;fontColor=#F8FAFC;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
