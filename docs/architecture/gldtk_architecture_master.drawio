        <mxCell id="mc_space" value="&lt;font style='font-size:10px' color='#0F766E'&gt;&lt;b&gt;[SPACE]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Space Embedding into Carvers&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;mission/space.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Assigns mission roles to&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;carved terrain sections &amp;amp;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;semantic room/dead-end anchors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
