        <mxCell id="fe_route" value="&lt;font style='font-size:10px' color='#4338CA'&gt;&lt;b&gt;[OVERLAY]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Live Canvas Route Overlay&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Draws verified Start-&amp;gt;Exit path on LDtk canvas&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Color-coded walks, hops, drops &amp;amp; abilities used&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Highlights soft-lock trap spans in red&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Auto-refreshes via POST /route after edits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
