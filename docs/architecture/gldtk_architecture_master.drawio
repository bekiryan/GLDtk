        <mxCell id="s2_patch" value="&lt;font style='font-size:10px' color='#B45309'&gt;&lt;b&gt;[STAGE 2]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;2. Spec Validator &amp;amp; SymbolicPatcher&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;spec/level_spec.py + llm/patcher.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;SpecNormalizePatch: clamp bounds, scale complexity&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;EdgeReclassifyPatch: steep Walk -&amp;gt; Jump / Fall&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;VelocityPatch, AbilityAssignPatch, SteppingStonePatch&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Fixes Qwen/LLM drift without extra LLM calls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="475" y="330" width="420" height="134" as="geometry" />
        </mxCell>
        <mxCell id="s3_comp" value="&lt;font style='font-size:10px' color='#B45309'&gt;&lt;b&gt;[STAGE 3]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;3. Completeness &amp;amp; Fidelity Fill&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;pipeline/completeness.py + fidelity/{checker,fill}.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Extracts explicit &amp;amp; implicit prompt requirements&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Deterministically injects missing entities, start_item,&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;section P_&amp;lt;type&amp;gt; structures, and lock_key_cycle&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;At most 1 complete_spec() LLM re-prompt if still short&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="475" y="512" width="420" height="134" as="geometry" />
