        <mxCell id="s_world" value="&lt;font style='font-size:10px' color='#475569'&gt;&lt;b&gt;[WORLDS]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Multi-Level Worlds &amp;amp; Endless Chunks&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;pipeline/world.py &amp;amp; pipeline/chunks.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;WorldOutline -&amp;gt; 1..8 linked levels (Exit -&amp;gt; next Start)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Regenerate single level while keeping sibling levels&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;POST /chunks appends deterministic seeded chunks&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Joined via fixed border port seams &amp;amp; verified per chunk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="475" y="875" width="420" height="145" as="geometry" />
        </mxCell>
        <mxCell id="s5_terrain" value="&lt;font style='font-size:10px' color='#0F766E'&gt;&lt;b&gt;[STAGE 5]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;5. Terrain Carving &amp;amp; RAG Pattern Stamping&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;layout/terrain/ + pipeline/stamps.py (StampFinder)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;7 rock carvers: corridor · parkour · labyrinth ·&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;arena · shaft (zigzag) · hub · open&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Matches RAG windows by geometry class &amp;amp; height;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;rock padding &amp;amp; vertical stacking + level_route check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1065" y="152" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s6_verify" value="&lt;font style='font-size:10px' color='#047857'&gt;&lt;b&gt;[STAGE 6]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;6. Grid Extraction, Physics &amp;amp; Soft-Lock Verify&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;symbolic/{extractor,physics,walljump,gravity}.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;layout/verify.py + layout/softlock.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Swept 12x24 px AABB hitbox (ds &amp;lt;= 6 px), headroom &amp;gt;= 2&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Checks single/double jump (tau*), dash, wall kick, g(x)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Tarjan SCC traps + Item-State Product Graph V x P(K)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Counterfactual check: no key placed behind its door&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
