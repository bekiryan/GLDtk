        <mxCell id="in_invariant" value="&lt;font style='font-size:10px' color='#60A5FA'&gt;&lt;b&gt;[INVARIANT]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#F8FAFC'&gt;&lt;b&gt;Core Safety Guarantee&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;Unverified levels are NEVER written to disk.&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;Every exported level proves:&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;1. Swept 12x24 hitbox Start-&amp;gt;Exit path&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;2. 0 SCC traps &amp;amp; 0 item-state soft-locks&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#CBD5E1'&gt;3. Validated LDtk 1.5.3 JSON schema&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1E293B;strokeColor=#334155;strokeWidth=1.6;fontColor=#F8FAFC;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
