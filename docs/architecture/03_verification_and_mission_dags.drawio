        <mxCell id="g_softlock" value="&lt;b&gt;Sub-DAG B · Soft-Lock Freedom Proofs &amp;amp; Auto-Repair (layout/softlock*.py)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px' color='#334155'&gt;Guarantees every reachable platform and inventory state can still reach an Exit&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=46;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.8;swimlaneFillColor=#FFF1F2;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
