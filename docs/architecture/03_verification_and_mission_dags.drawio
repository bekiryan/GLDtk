        <mxCell id="g_oracle" value="&lt;b&gt;Sub-DAG A · Kinematic Physics Oracle &amp;amp; Swept-Hitbox Verification (symbolic/)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:11px' color='#334155'&gt;Evaluates continuous Newtonian arcs &amp;amp; 12x24 px AABB clearance across heterogeneous gravity bands&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=46;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.8;swimlaneFillColor=#ECFDF5;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1">
