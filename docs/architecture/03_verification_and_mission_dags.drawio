        <mxCell id="verification_dags_title" value="&lt;font style='font-size:20px' color='#0F172A'&gt;&lt;b&gt;GLDtk: Formal Verification, Soft-Lock SCC/Automaton, Mission &amp;amp; Seam-Locked Edit DAGs&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#475569'&gt;Mathematical guarantees &amp;amp; non-destructive co-creative editing subsystems&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
