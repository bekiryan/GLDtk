        <mxCell id="s7_comfort" value="&lt;font style='font-size:10px' color='#0F766E'&gt;&lt;b&gt;[STAGE 7]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;7. Comfort Pass &amp;amp; Chebyshev Densification&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;layout/comfort.py + layout/densify.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Effort-cost A* (walk=1.0, super-linear jump cost)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Adds hop_N ledges for comfort limits (outside parkour)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;2D Chebyshev distance transform void platform infill&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Discards any fill platform obstructing golden arcs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1065" y="736" width="420" height="128" as="geometry" />
        </mxCell>
        <mxCell id="s8_complex" value="&lt;font style='font-size:10px' color='#047857'&gt;&lt;b&gt;[STAGE 8]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;8. Closed-Loop Complexity Controller&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;pipeline/complexity.py + fidelity/difficulty.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;5-factor score: jumps, enemies, hazards, ledges, relief&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Iteratively adjusts gaps &amp;amp; density toward target (1..10)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Re-lays out &amp;amp; re-verifies each round (&amp;lt;= MAX_ROUNDS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1065" y="916" width="420" height="126" as="geometry" />
        </mxCell>
        <mxCell id="s9_noise" value="&lt;font style='font-size:10px' color='#1D4ED8'&gt;&lt;b&gt;[STAGE 9]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;9. Noise Cavern Rock Fill&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;layout/fill.py + layout/noise.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Domain-warped fBm simplex noise&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;4–5 Cellular Automata smoothing passes&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Decorative Background IntGrid layer&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Strictly avoids protected route envelope&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
