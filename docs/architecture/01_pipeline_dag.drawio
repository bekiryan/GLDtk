        <mxCell id="s1_llm" value="&lt;font style='font-size:10px' color='#6D28D9'&gt;&lt;b&gt;[STAGE 1]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;1. LLMController &amp;amp; Provider Cascade&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;llm/validator.py + llm/providers/registry.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Primary: gemini-3.8-flash -&amp;gt; 3.1-flash-lite (503 backoff)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Auto Fallback: ollama:qwen2.5:14b (900s local timeout)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Also supports Claude (cached), OpenAI, DeepSeek&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Schema-enforced JSON output: LevelSpec.json_schema()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
