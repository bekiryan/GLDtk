        <mxCell id="s6_repair" value="&lt;font style='font-size:10px' color='#BE123C'&gt;&lt;b&gt;[REPAIR]&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:12px' color='#0F172A'&gt;&lt;b&gt;Deterministic Grid &amp;amp; Soft-Lock Repair&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;layout/repair.py + layout/softlock_repair.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Retry failing terrain section seeds (&amp;lt;= TERRAIN_ATTEMPTS)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Synthesize stepping stones, raise low ceilings, relocate keys&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10.5px' color='#334155'&gt;Last resort: controller.repair_spec() (&amp;lt;= 2 LLM retries)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.6;fontColor=#0F172A;fontSize=12;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1065" y="558" width="420" height="124" as="geometry" />
